# ============================================================
#  .env.example  —  copy to .env and fill in
# ============================================================
#   cp .env.example .env
#
# .env is gitignored and is the ONLY place your keys live. From it:
#
#   python3 tools/apply_env.py     writes firmware/config.lamp*.py
#   python3 tools/test_bridge.py   picks up the worker URL and secret
#
# Nothing here is ever committed. The generated lamp configs are
# gitignored too, so there is no file you have to remember not to add.

# ── Lamp 1 ──────────────────────────────────────────────────
# NAME is optional and only cosmetic: it appears in the lamp's own WiFi
# network name. Leave it blank and the network is just "deLENIghted-1".
LAMP1_NAME    =
LAMP1_DEV_EUI =                     # 16 hex, from the TTN device page
LAMP1_APP_KEY =                     # 32 hex, Join settings, eye icon

# ── Lamp 2 ──────────────────────────────────────────────────
LAMP2_NAME    =
LAMP2_DEV_EUI =
LAMP2_APP_KEY =

# ── Shared by both lamps ────────────────────────────────────
# The JoinEUI identifies the join server, not the lamp, so it is the SAME
# on both and must match what you typed into the TTN console. TTN allows
# all zeros, but some LoRaWAN stacks read that as "not configured" and
# refuse to join without saying so — hence a made-up value.
JOIN_EUI      = 0011223344556677
LORA_REGION   = EU868

# ── The strip ───────────────────────────────────────────────
# How many LEDs you soldered, and how many colour zones to split them
# into. The zones reshuffle on every touch, as in the original project;
# both lamps derive identical ones, so it costs nothing on the wire.
# NUM_GROUPS = 1 gives one flat colour across the strip.
NUM_LEDS      = 10
NUM_GROUPS    = 3
GROUP_SPREAD  = 0.35            # 0 = zones identical, 1 = wildly apart
LED_ORDER     = GRBW            # SK6812 RGBW; GRB for WS2812 (no white)

# ── The lamp's own WiFi network ─────────────────────────────
# At least 8 characters, or the ESP32 silently brings the network up OPEN.
PORTAL_PASSWORD = lightupleni

# ── Optional home WiFi ──────────────────────────────────────
# Leave blank for LoRa only. Can also be entered later from the lamp's
# own page, without a cable.
WIFI_SSID     =
WIFI_PASSWORD =

# ── The bridge ──────────────────────────────────────────────
# Used by tools/test_bridge.py so you do not paste these on the command
# line, where they end up in your shell history.
WORKER_URL    =                     # https://....workers.dev
SHARED_SECRET =                     # the same value as the webhook header
TTN_APP_ID    =                     # e.g. friend-lights
TTN_API_KEY   =                     # NNSXS.... with "write downlink"
TTN_CLUSTER   = eu1
